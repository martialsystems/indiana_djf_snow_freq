{
  "runtime_checks": [
    {
      "id": "unit-tests",
      "argv": [".venv/bin/python", "-m", "pytest", "tests/", "-q"],
      "timeout_s": 180,
      "paths": ["src/**", "tests/**", "scripts/**", "snowfreqforge/**", "requirements.txt", "vbd.runtime.json"]
    },
    {
      "id": "fixture-path",
      "argv": [".venv/bin/python", "scripts/run_fixture.py", "logs/stage0_fixture"],
      "timeout_s": 120,
      "paths": ["src/**", "scripts/**"]
    },
    {
      "id": "snowfreqforge-sanity",
      "argv": [".venv/bin/python", "snowfreqforge/scripts/sanity_snowfreqforge.py"],
      "timeout_s": 60,
      "paths": ["snowfreqforge/**", "tests/test_snowfreqforge_laws.py"]
    }
  ]
}
